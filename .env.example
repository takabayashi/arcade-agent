# Copy this file to .env and fill in your keys.
# .env is gitignored.

# From https://api.arcade.dev/dashboard
ARCADE_API_KEY=

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: override the Anthropic model (default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5
